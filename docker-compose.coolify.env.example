# FrameCast Coolify environment variables
# Copy this file, fill in the values, set as project env in Coolify

# ===================
# REQUIRED
# ===================

# Public URL where FrameCast is reachable
WEB_URL=https://framecast.frameempire.co.uk

# 32-byte hex string for encrypting sensitive data
# Generate with: openssl rand -hex 32
DATABASE_ENCRYPTION_KEY=

# 32-byte secret for NextAuth sessions
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Secret for media-server webhook authentication
# Generate with: openssl rand -hex 32
MEDIA_SERVER_WEBHOOK_SECRET=

# ===================
# AUTH / SIGN-IN
# ===================

# Restrict sign-in to this email domain (comma-separated for multiple)
EMAIL_ALLOWLIST_DOMAIN=frameempire.co.uk

# ===================
# DATABASE
# ===================

MYSQL_PASSWORD=your-secure-mysql-password
MYSQL_ROOT_PASSWORD=your-secure-root-password

# ===================
# S3 / Cloudflare R2
# ===================

# R2 access keys (mapped via docker-compose to MINIO_ROOT_* names internally)
MINIO_ROOT_USER=your-r2-access-key-id
MINIO_ROOT_PASSWORD=your-r2-secret-access-key

# Bucket name in R2
CAP_AWS_BUCKET=framecast-videos

# Public URL for video playback (R2 custom domain)
S3_PUBLIC_ENDPOINT=https://r2.framecast.frameempire.co.uk

# Internal R2 endpoint (the standard cloudflarestorage.com one)
S3_INTERNAL_ENDPOINT=https://<your-r2-account-id>.r2.cloudflarestorage.com

# R2 needs virtual-hosted style URLs, not path style
S3_PATH_STYLE=false

# AWS_REGION is required by the SDK; "auto" works for R2
CAP_AWS_REGION=auto

# ===================
# EMAIL (Resend, for magic-link sign-in)
# ===================

# Without RESEND_API_KEY, login codes are logged to container stdout
RESEND_API_KEY=
RESEND_FROM_DOMAIN=frameempire.co.uk

# ===================
# FEATURE FLAGS
# ===================

# Keep these all "false" for internal Frame Empire use
NEXT_PUBLIC_IS_CAP=false
NEXT_PUBLIC_FEATURES_AI=false
NEXT_PUBLIC_FEATURES_MARKETING=false

# ===================
# AI providers (optional, leave unset if FEATURES_AI=false)
# ===================

DEEPGRAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ===================
# OAuth (optional, magic-link is sufficient for 6-person team)
# ===================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
